# ==========================================
# GEMINI DATALAB FOR EXCEL - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=4000
API_HOST=localhost
LOG_LEVEL=info

# CORS Allowed Origins (Comma separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://localhost:3000,https://localhost:3001

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/gemini_datalab
MONGODB_USER=
MONGODB_PASSWORD=

# Cache & Message Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication (JWT)
JWT_SECRET=datalab-super-secret-jwt-key-replace-in-production-min32chars
JWT_REFRESH_SECRET=datalab-refresh-secret-jwt-key-replace-in-production-min32chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Storage & Uploads
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE_MB=100

# Client App URLs
WEB_APP_URL=http://localhost:3000
EXCEL_ADDIN_URL=https://localhost:3001
